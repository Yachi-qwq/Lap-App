<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/questionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="12dp"
    app:cardBackgroundColor="@color/surface_dark_glass"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Container für dynamische Bilder (Ganz oben im Item) -->
        <LinearLayout
            android:id="@+id/containerImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvQuestionId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text_white_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_white_pure"
            android:textSize="20sp"
            android:lineSpacingExtra="6dp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/text_white_dim"
            android:alpha="0.2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAnswerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grad_blue_end"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <!-- Rating Buttons -->
        <LinearLayout
            android:id="@+id/layoutRatingsInItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBadItem"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@android:drawable/btn_minus"
                app:iconTint="@color/rating_bad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMediumItem"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@android:drawable/ic_dialog_alert"
                app:iconTint="@color/rating_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoodItem"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@android:drawable/btn_star"
                app:iconTint="@color/rating_good" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
