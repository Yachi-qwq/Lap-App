<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.LapApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/grad_purple_start</item>
        <item name="colorOnPrimary">@color/text_white_pure</item>
        <item name="colorPrimaryContainer">@color/surface_dark_glass</item>
        <item name="colorOnPrimaryContainer">@color/text_white_pure</item>

        <item name="colorSecondary">@color/grad_blue_end</item>
        <item name="colorOnSecondary">@color/text_white_pure</item>

        <item name="colorTertiary">@color/grad_pink_start</item>

        <!-- Status and Navigation Bar -->
        <item name="android:statusBarColor">@color/bg_deep_dark</item>
        <item name="android:navigationBarColor">@color/bg_deep_dark</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/bg_deep_dark</item>
        <item name="colorSurface">@color/bg_deep_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark_glass</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_white_pure</item>
        <item name="android:textColorSecondary">@color/text_white_secondary</item>

        <!-- Shape -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LapApp.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LapApp.Medium</item>

        <!-- Material Alert Dialog Theme -->
        <item name="materialAlertDialogTheme">@style/MyDialogTheme</item>
    </style>

    <style name="Theme.LapApp" parent="Base.Theme.LapApp" />

    <!-- Modern Dark Dialog Theme -->
    <style name="MyDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_dark_glass</item>
        <item name="android:textColorPrimary">@color/text_white_pure</item>
        <item name="android:textColorSecondary">@color/text_white_secondary</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LapApp.Large</item>
        <!-- Background dim -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.LapApp.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.LapApp.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Glass Button Style -->
    <style name="Widget.LapApp.Button.Glass" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LapApp.Medium</item>
        <item name="android:textColor">@color/text_white_pure</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Rating Button Styles -->
    <style name="Widget.LapApp.Button.Rating" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.LapApp.Large</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>
</resources>